---
import { Image } from 'astro:assets';
import logoMark from '../assets/brand/logo-mark.png';

// The Freedom School wordmark: the crystal bloom mark + the name.
// The wordmark uses currentColor, so the parent controls its color
// (dark on light surfaces, white over the hero).
interface Props {
  class?: string;
  size?: number;
}
const { class: cls = '', size = 34 } = Astro.props;
---

<span class:list={['logo', cls]}>
  <Image
    class="logo-bloom"
    src={logoMark}
    alt=""
    width={size}
    height={size}
    densities={[1, 2, 3]}
    aria-hidden="true"
  />
  <span class="logo-word">The Freedom<br />School</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .logo-bloom { flex: none; }
  .logo-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.06rem;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: currentColor;
    white-space: nowrap;
  }
</style>
