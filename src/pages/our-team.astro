---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import CoralArt from '../components/CoralArt.astro';
import { team, teamIsPlaceholder, leadership, advisors } from '../data/team';
---

<BaseLayout
  title="Our Team"
  description="Meet the Learning Leaders behind The Freedom School — experienced educators and mentors who think outside the square."
>
  <PageHero
    eyebrow="Our Team"
    title="The people behind The Freedom School"
    lead="We’re assembling a team of world-class educators and mentors — Learning Leaders who honor each student’s curiosity and help them thrive."
    coral={2}
  />

  <section class="section">
    <div class="container">
      <header class="section-head center">
        <p class="eyebrow">Leadership</p>
        <h2>Meet our founders</h2>
      </header>
      <div class="grid grid--2 team-grid leadership-grid">
        {leadership.map((m, i) => (
          <article class="member">
            <div class="avatar">
              <CoralArt n={(i % 8) + 1} size={120} />
              <img
                src={m.image}
                alt={m.alt}
                loading="lazy"
                onerror="this.remove()"
                class:list={[i === 1 && 'avatar-img--zoom']}
              />
            </div>
            <h3>{m.name}</h3>
            <p class="member-role">{m.role}</p>
            <p class="member-bio">{m.bio}</p>
          </article>
        ))}
      </div>
      <div class="grid team-grid leadership-grid advisor-grid">
        {advisors.map((m) => (
          <article class="member">
            <div class="avatar">
              <CoralArt n={2} size={120} />
              <img src={m.image} alt={m.alt} loading="lazy" onerror="this.remove()" />
            </div>
            <h3>{m.name}</h3>
            <p class="member-role">{m.role}</p>
            <p class="member-bio">{m.bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Archived for later: placeholder "Learning Leaders" cards, on hold until real
      hires/bios are ready. Flip `false` to `true` to bring this section back —
      content lives in src/data/team.ts (`team`, `teamIsPlaceholder`). */}
  {false && (
    <section class="section section--cream">
      <div class="container">
        <header class="section-head center">
          <p class="eyebrow">Learning Leaders</p>
          <h2>The educators and mentors joining them</h2>
        </header>
        {teamIsPlaceholder && (
          <p class="placeholder-note">
            ✦ We’re finalising our founding team. Full names, photos and bios will appear here soon.
          </p>
        )}
        <div class="grid grid--3 team-grid">
          {team.map((m, i) => (
            <article class="member">
              <div class="avatar" aria-hidden="true"><CoralArt n={(i % 8) + 1} size={120} /></div>
              <h3>{m.name}</h3>
              <p class="member-role">{m.role}</p>
              <p class="member-bio">{m.bio}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container container--narrow center join">
      <h2>Could you be a Learning Leader?</h2>
      <p class="lead">We’re always looking for educators who believe school should spark imagination, build confidence and nurture the whole human.</p>
      <a href="/careers" class="btn btn--coral btn--lg">See careers</a>
    </div>
  </section>

  <CtaBand coral={4} />
</BaseLayout>

<style>
  .placeholder-note {
    text-align: center; color: var(--coral-ink); font-size: var(--fs-sm);
    background: var(--mint); border-radius: var(--r-pill);
    padding: 0.7rem 1.25rem; margin-inline: auto; margin-bottom: 2.5rem; max-width: max-content;
  }
  .team-grid { gap: 2rem; }
  .leadership-grid { max-width: 720px; margin-inline: auto; }
  .advisor-grid { max-width: 344px; margin-top: 2rem; justify-content: center; }
  .leadership-grid .avatar { width: 200px; height: 200px; margin-bottom: 1.3rem; }
  .member { text-align: center; }
  .avatar {
    position: relative;
    width: 132px; height: 132px; margin: 0 auto 1.1rem;
    display: grid; place-items: center;
    background: radial-gradient(circle at 50% 40%, var(--cream-2), var(--mint));
    border-radius: 50%;
    overflow: hidden;
  }
  .avatar img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center 15%;
  }
  /* Dahlia's source photo is a wider, further-back shot than Alina's tight
     headshot — scale it up so the two faces read at a similar size. */
  .avatar-img--zoom { transform: scale(1.55); transform-origin: 50% 22%; }
  .member h3 { font-size: 1.2rem; }
  .member-role { color: var(--coral-ink); font-weight: 500; font-size: var(--fs-sm); margin-top: 0.2rem; }
  .member-bio { color: var(--text-muted); font-size: var(--fs-sm); margin-top: 0.7rem; }
  .join h2 { margin-bottom: 0.8rem; }
  .join .lead { margin-inline: auto; margin-bottom: 1.5rem; }
</style>
